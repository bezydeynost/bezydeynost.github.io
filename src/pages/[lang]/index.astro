---
import {ui} from '../../i18n/ui';
import Home from '../../components/Home.astro';

const {lang: langParam} = Astro.params;

if (!langParam || !(langParam in ui)) {
  return new Response(null, {status: 404});
}

const lang = langParam as keyof typeof ui;
Astro.cookies.set('lang', lang, {path: '/', maxAge: 31536000, sameSite: 'lax'});
---

<Home lang={lang} />
