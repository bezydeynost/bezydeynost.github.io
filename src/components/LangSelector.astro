---
import {getLangFromUrl} from '../i18n/utils';
import {ui, defaultLang} from '../i18n/ui';

interface Props {
  currentLang?: keyof typeof ui;
}

const langs = [
  {name: '🇷🇺 Русский', path: '/ru', code: 'ru'},
  {name: '🇺🇸 English', path: '/en', code: 'en'}
] as const;

const {currentLang: propLang} = Astro.props;
const currentLangCode = propLang ?? getLangFromUrl(Astro.url);
const currentLang =
  langs.find(l => l.code === currentLangCode) ??
  langs.find(l => l.code === defaultLang) ??
  langs[0];
---

<div class="rounded-lg inline-block">
  <button id="currentLang" class="dropdown-option rounded-lg noto-emoji"
    >{currentLang.name}</button
  >

  <div id="lang-dropdown" class="hidden">
    <ul
      class="absolute divide-y divide-surface0 z-10 rounded-lg overflow-hidden"
    >
      {
        langs.map(o => (
          <li
            role="link"
            data-href={o.path}
            data-lang={o.code}
            class="dropdown-option noto-emoji"
          >
            {o.name}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  #lang-dropdown {
    @apply rounded-lg relative z-10;
  }

  #lang-dropdown ul {
    @apply mt-2;
  }

  .dropdown-option {
    @apply bg-crust hover:bg-surface0 px-4 py-2 min-w-40 text-left select-none cursor-pointer;
  }
</style>

<script>
  const button = document.getElementById('currentLang')! as HTMLButtonElement;
  const dropdown = document.querySelector<HTMLUListElement>(
    '#lang-dropdown > ul'
  )!;

  const currentHtmlLang = document.documentElement.lang;
  if (currentHtmlLang) {
    const matchingOption = dropdown.querySelector<HTMLLIElement>(
      `li[data-lang="${currentHtmlLang}"]`
    );
    if (matchingOption) {
      button.innerText = matchingOption.innerText;
    }
  }

  dropdown.onclick = e => {
    const target = (e.target as HTMLElement)?.closest('li');
    if (!target || !(target instanceof HTMLLIElement)) {
      return;
    }

    const lang = target.dataset.lang;
    if (lang) {
      document.cookie = `lang=${lang}; path=/; max-age=31536000; SameSite=Lax`;
      localStorage.setItem('lang', lang);
    }

    window.location.href = target.dataset.href!;
    dropdown.parentElement!.classList.add('hidden');
    document.removeEventListener('click', outsideClickListener);
  };
  button.onclick = () => {
    const wasHidden = dropdown.parentElement!.classList.contains('hidden');
    dropdown.parentElement!.classList.remove('hidden');
    setTimeout(() => {
      if (wasHidden) document.addEventListener('click', outsideClickListener);
    }, 0);
  };

  function outsideClickListener(event: MouseEvent) {
    if (dropdown.contains(event.target as Node)) {
      return;
    }

    dropdown.parentElement!.classList.add('hidden');
    document.removeEventListener('click', outsideClickListener);
  }
</script>
